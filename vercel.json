{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{profiles,data}/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/superadmin",
      "destination": "/super-admin",
      "permanent": false
    },
    {
      "source": "/superadmin/login",
      "destination": "/super-admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.ts?__route=health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts?__route=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
