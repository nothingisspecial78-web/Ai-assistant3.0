{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "assistant-api": {
      "root": "packages/server",
      "runtime": "node",
      "entrypoint": "src/vercel.ts",
      "bindings": [
        {
          "type": "service",
          "service": "demo-college-finance",
          "format": "url",
          "env": "DEMO_COLLEGE_FINANCE_URL"
        },
        {
          "type": "service",
          "service": "second-demo-app",
          "format": "url",
          "env": "SECOND_DEMO_APP_URL"
        }
      ]
    },
    "demo-college-finance": {
      "root": "apps/demo-college-finance",
      "runtime": "node",
      "entrypoint": "server.ts"
    },
    "second-demo-app": {
      "root": "apps/second-demo-app",
      "runtime": "node",
      "entrypoint": "server.ts"
    }
  },
  "redirects": [
    {
      "source": "/superadmin",
      "destination": "/super-admin",
      "permanent": false
    },
    {
      "source": "/superadmin/login",
      "destination": "/super-admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/demo/college-finance/(.*)",
      "destination": {
        "service": "demo-college-finance"
      }
    },
    {
      "source": "/api/demo/college-finance",
      "destination": {
        "service": "demo-college-finance"
      }
    },
    {
      "source": "/api/demo/second-demo/(.*)",
      "destination": {
        "service": "second-demo-app"
      }
    },
    {
      "source": "/api/demo/second-demo",
      "destination": {
        "service": "second-demo-app"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "assistant-api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "assistant-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
